# PantryPal environment variables
# Copy this file to `.env` and fill in your own values.
# All variables use Expo's EXPO_PUBLIC_ prefix so they are available in the app.

# Supabase (https://supabase.com) — the anon key is safe for client use with RLS enabled
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Spoonacular Recipe API (https://spoonacular.com/food-api)
EXPO_PUBLIC_SPOONACULAR_API_KEY=your-spoonacular-api-key

# Google Cloud Vision API for OCR (https://console.cloud.google.com/)
EXPO_PUBLIC_GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-vision-api-key

# Dev only: set to "true" to bypass the login screen during local development.
# Ignored entirely in production builds (double-gated behind __DEV__).
# EXPO_PUBLIC_DEV_BYPASS_AUTH=true

# Note: barcode scanning works with NO keys — it uses the free Open Food Facts
# database. Recipe discovery and OCR fall back to sensible mock data until
# their keys are provided, so the whole app is usable out of the box.
