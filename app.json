{
  "expo": {
    "name": "PantryPal",
    "slug": "PantryPal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pantrypal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#14B8A6",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14B8A6"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rahilsheth.pantrypal",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "PantryPal uses your camera to scan product barcodes so you can add groceries to your pantry in seconds.",
        "NSPhotoLibraryUsageDescription": "PantryPal accesses your photos so you can scan receipts and add items from images.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14B8A6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.rahilsheth.pantrypal",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "PantryPal uses your camera to scan product barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PantryPal accesses your photos so you can scan receipts."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14B8A6"
        }
      ]
    ]
  }
}
